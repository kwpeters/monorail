{
    "name": "@repo/mille-bornes-core",
    "version": "0.0.0",
    "type": "module",
    "private": true,
    "scripts": {
        "dev": "echo 'Add dev script here'",
        "build": "tsc --build tsconfig.src.json",
        "test": "tsx ../../node_modules/jasmine/bin/jasmine.js --color --config=./jasmine.json",
        "lint": "eslint .",
        "type-check": "tsc --project tsconfig.json --noEmit",
        "depcheck": "depcheck",
        "soak": "tsx ./src/soak.mts"
    },
    "exports": {
        "./ids": {
            "types": "./src/ids.mts",
            "default": "./dist/ids.mjs"
        },
        "./miles": {
            "types": "./src/miles.mts",
            "default": "./dist/miles.mjs"
        },
        "./playerName": {
            "types": "./src/playerName.mts",
            "default": "./dist/playerName.mjs"
        },
        "./points": {
            "types": "./src/points.mts",
            "default": "./dist/points.mjs"
        }
    },
    "devDependencies": {
        "@repo/eslint-config": "*",
        "@repo/typescript-config": "*",
        "@types/jasmine": "^6.0.0",
        "eslint": "^10.0.1",
        "fast-check": "^4.0.0",
        "jasmine": "^6.1.0"
    },
    "dependencies": {
        "@repo/depot": "*",
        "zod": "^4.3.6"
    }
}
